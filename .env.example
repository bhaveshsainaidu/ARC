# ── ARC Environment Configuration ──────────────────────────────────────────
GEMINI_API_KEY=your_gemini_api_key_here
ARC_ENVIRONMENT=production
ARC_LOG_LEVEL=INFO

# ── Hardware Acceleration Overrides ───────────────────────────────────────
# Set to 'direct3d11', 'vulkan', or 'opengl' (Default: Direct3D 11 on Windows)
QSG_RHI_BACKEND=d3d11
QT_QUICK_CONTROLS_STYLE=Basic
OPENCV_OPENCL_DEVICE=GPU

# ── Remote Dashboard Configuration ────────────────────────────────────────
DASHBOARD_PORT=8000
DASHBOARD_HOST=0.0.0.0
